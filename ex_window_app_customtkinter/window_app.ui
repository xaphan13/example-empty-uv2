<?xml version="1.0" encoding="UTF-8"?>
<!--
    Pygubu-разметка главного окна ex_window_app_customtkinter (редизайн v3 «Aurora Night»).

    Корневой объект — `customtkinter.CTkFrame` id `main_frame` на фоне #0b0e14.
    Окно `ctk.CTk()`, `ctk.set_appearance_mode("Dark")` и
    `ctk.set_default_color_theme("blue")` создаёт код в
    `application_window.py`; корневой фрейм встраивается в окно через
    `Builder.get_object('main_frame', master=window)`.

    Раскладка — grid 2 столбца:
      - столбец 0: сайдбар (sidebar_frame), ширина задаётся кодом (minsize 320).
      - столбец 1: контент (content_frame), растягивается (weight=1).
    Grid-веса надёжнее настраивать кодом (pygubu округляет веса); в
    `application_window.py.__init__` рантайм-веса пересчитываются явно.

    Сайдбар: бренд-заголовок с бейджем версии, поиск, счётчик,
    карточки примеров (5 шт.), футер с версиями библиотек.

    Контент (grid 1x9):
      row 0 — шапка: example_title + example_desc;
      row 1 — topbar_frame: переключатель темы (CTkSegmentedButton) и
              выбор акцента (CTkOptionMenu);
      row 2 — metrics_frame: 4 мини-карточки (Примеров, Запусков, Время, Статус);
      row 3 — tasks_frame: секция «Симуляция задач» — 3 кнопки-задачи и
              3 прогрессбара с именами и процентами;
      row 4 — demo_frame: секция «Демо-виджеты» — 5 кнопок (Тост, Волна,
              Вспышка, Сброс, Тест) + слайдер скорости со значением;
      row 5 — output_text («терминал», растягивается, weight=1);
      row 6 — progressbar (основной);
      row 7 — buttons_frame: run/clear/copy + два свитча опций терминала
              (clear_before_run_switch, autoscroll_switch) справа;
      row 8 — status_label.

    «Парящую» кнопку (FAB, круглая, поверх правого нижнего угла) создаёт
    код через place() — в grid её не положить.

    Палитра v3 «Aurora Night» (тёмная, см. константы в application_window.py):
      фон приложения #0b0e14, панели #11151f, карточки #171c29,
      бордеры #272f42, акцент #6d8dff, текст #d7defc, приглушённый #7d87a8.
    При переключении темы на светлую поверхности перекрашивает код.

    Формат составных отступов в `<property name="padx"/"pady">` — `a b`
    через пробел (tkinter не парсит `(a, b)`).
-->
<interface>
  <requires lib="customtkinter"/>
  <object class="customtkinter.CTkFrame" id="main_frame" name="main_frame">
    <property name="fg_color">#0b0e14</property>
    <property name="corner_radius">0</property>
    <property name="width">980</property>
    <property name="height">640</property>
    <child>
      <!--
          Сайдбар: панель #11151f, радиус 16. Содержимое:
          row 0 — бренд-строка (sidebar_title + sidebar_badge);
          row 1 — search_entry;
          row 2 — search_counter;
          row 3 — cards_scroll (растягивается);
          row 4 — sidebar_footer.
      -->
      <object class="customtkinter.CTkFrame" id="sidebar_frame" name="sidebar_frame">
        <property name="fg_color">#11151f</property>
        <property name="corner_radius">16</property>
        <property name="width">300</property>
        <child>
          <!--
              Бренд-строка: заголовок акцентным цветом + бейдж версии.
              Бейдж — маленькая «пилюля» с фоном карточки.
          -->
          <object class="customtkinter.CTkFrame" id="brand_frame" name="brand_frame">
            <property name="fg_color">transparent</property>
            <property name="corner_radius">0</property>
            <layout>
              <property name="row">0</property>
              <property name="column">0</property>
              <property name="sticky">ew</property>
              <property name="padx">16</property>
              <property name="pady">16 10</property>
            </layout>
            <child>
              <object class="customtkinter.CTkLabel" id="sidebar_title" name="sidebar_title">
                <property name="text">◆ Примеры</property>
                <property name="font">{Arial} 17 {bold}</property>
                <property name="text_color">#6d8dff</property>
                <layout>
                  <property name="row">0</property>
                  <property name="column">0</property>
                  <property name="sticky">w</property>
                  <property name="padx">0</property>
                  <property name="pady">0</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="customtkinter.CTkLabel" id="sidebar_badge" name="sidebar_badge">
                <property name="text">v3</property>
                <property name="font">{Arial} 9 {bold}</property>
                <property name="fg_color">#171c29</property>
                <property name="text_color">#7d87a8</property>
                <property name="corner_radius">8</property>
                <layout>
                  <property name="row">0</property>
                  <property name="column">1</property>
                  <property name="sticky">e</property>
                  <property name="padx">8 0</property>
                  <property name="pady">2 0</property>
                </layout>
              </object>
            </child>
            <layout_manager>
              <property name="grid">x</property>
              <property name="row_weights">{0: 0}</property>
              <property name="column_weights">{0: 1, 1: 0}</property>
            </layout_manager>
          </object>
        </child>
        <child>
          <object class="customtkinter.CTkEntry" id="search_entry" name="search_entry">
            <property name="placeholder_text">Поиск примера...</property>
            <property name="placeholder_text_color">#565f7d</property>
            <property name="fg_color">#141926</property>
            <property name="border_color">#272f42</property>
            <property name="text_color">#d7defc</property>
            <property name="corner_radius">10</property>
            <layout>
              <property name="row">1</property>
              <property name="column">0</property>
              <property name="sticky">ew</property>
              <property name="padx">14</property>
              <property name="pady">0 8</property>
            </layout>
          </object>
        </child>
        <child>
          <!--
              Счётчик найденных карточек. Текст обновляется кодом
              (формат «Найдено: N из 5»).
          -->
          <object class="customtkinter.CTkLabel" id="search_counter" name="search_counter">
            <property name="text">Найдено: 5 из 5</property>
            <property name="font">{Arial} 10 {}</property>
            <property name="text_color">#565f7d</property>
            <layout>
              <property name="row">2</property>
              <property name="column">0</property>
              <property name="sticky">w</property>
              <property name="padx">16</property>
              <property name="pady">0 6</property>
            </layout>
          </object>
        </child>
        <child>
          <!--
              CTkScrollableFrame: прозрачный фон, без скруглений, занимает
              всю оставшуюся высоту сайдбара. Карточки-примеры раскладываются
              grid'ом внутри (row 0..4).
          -->
          <object class="customtkinter.CTkScrollableFrame" id="cards_scroll" name="cards_scroll">
            <property name="fg_color">transparent</property>
            <property name="corner_radius">0</property>
            <layout>
              <property name="row">3</property>
              <property name="column">0</property>
              <property name="sticky">nsew</property>
              <property name="padx">10</property>
              <property name="pady">4</property>
            </layout>
            <child>
              <!--
                  Карточка примера `async_context_var`. Стили: радиус 12,
                  фон #171c29, бордер #272f42. Hover/selection — код.
              -->
              <object class="customtkinter.CTkFrame" id="card_async_context_var" name="card_async_context_var">
                <property name="fg_color">#171c29</property>
                <property name="border_color">#272f42</property>
                <property name="border_width">1</property>
                <property name="corner_radius">12</property>
                <layout>
                  <property name="row">0</property>
                  <property name="column">0</property>
                  <property name="sticky">ew</property>
                  <property name="pady">3</property>
                </layout>
                <child>
                  <object class="customtkinter.CTkLabel" id="card_title_async_context_var" name="card_title_async_context_var">
                    <property name="text">Async: ContextVar в задачах</property>
                    <property name="font">{Arial} 12 {bold}</property>
                    <property name="text_color">#d7defc</property>
                    <property name="anchor">w</property>
                    <layout>
                      <property name="row">0</property>
                      <property name="column">0</property>
                      <property name="sticky">ew</property>
                      <property name="padx">12</property>
                      <property name="pady">10 2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="customtkinter.CTkLabel" id="card_desc_async_context_var" name="card_desc_async_context_var">
                    <property name="text">ContextVar и asyncio-задачи</property>
                    <property name="font">{Arial} 10 {}</property>
                    <property name="text_color">#565f7d</property>
                    <property name="justify">left</property>
                    <property name="anchor">w</property>
                    <layout>
                      <property name="row">1</property>
                      <property name="column">0</property>
                      <property name="sticky">ew</property>
                      <property name="padx">12</property>
                      <property name="pady">0 10</property>
                    </layout>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <!-- Карточка примера `valid_bracket`. -->
              <object class="customtkinter.CTkFrame" id="card_valid_bracket" name="card_valid_bracket">
                <property name="fg_color">#171c29</property>
                <property name="border_color">#272f42</property>
                <property name="border_width">1</property>
                <property name="corner_radius">12</property>
                <layout>
                  <property name="row">1</property>
                  <property name="column">0</property>
                  <property name="sticky">ew</property>
                  <property name="pady">3</property>
                </layout>
                <child>
                  <object class="customtkinter.CTkLabel" id="card_title_valid_bracket" name="card_title_valid_bracket">
                    <property name="text">Code War: проверка скобочных последовательностей</property>
                    <property name="font">{Arial} 12 {bold}</property>
                    <property name="text_color">#d7defc</property>
                    <property name="anchor">w</property>
                    <layout>
                      <property name="row">0</property>
                      <property name="column">0</property>
                      <property name="sticky">ew</property>
                      <property name="padx">12</property>
                      <property name="pady">10 2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="customtkinter.CTkLabel" id="card_desc_valid_bracket" name="card_desc_valid_bracket">
                    <property name="text">Баланс скобок в строке</property>
                    <property name="font">{Arial} 10 {}</property>
                    <property name="text_color">#565f7d</property>
                    <property name="justify">left</property>
                    <property name="anchor">w</property>
                    <layout>
                      <property name="row">1</property>
                      <property name="column">0</property>
                      <property name="sticky">ew</property>
                      <property name="padx">12</property>
                      <property name="pady">0 10</property>
                    </layout>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <!-- Карточка примера `zip_operations`. -->
              <object class="customtkinter.CTkFrame" id="card_zip_operations" name="card_zip_operations">
                <property name="fg_color">#171c29</property>
                <property name="border_color">#272f42</property>
                <property name="border_width">1</property>
                <property name="corner_radius">12</property>
                <layout>
                  <property name="row">2</property>
                  <property name="column">0</property>
                  <property name="sticky">ew</property>
                  <property name="pady">3</property>
                </layout>
                <child>
                  <object class="customtkinter.CTkLabel" id="card_title_zip_operations" name="card_title_zip_operations">
                    <property name="text">ZIP: запись и чтение архивов</property>
                    <property name="font">{Arial} 12 {bold}</property>
                    <property name="text_color">#d7defc</property>
                    <property name="anchor">w</property>
                    <layout>
                      <property name="row">0</property>
                      <property name="column">0</property>
                      <property name="sticky">ew</property>
                      <property name="padx">12</property>
                      <property name="pady">10 2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="customtkinter.CTkLabel" id="card_desc_zip_operations" name="card_desc_zip_operations">
                    <property name="text">zipfile: создание и чтение</property>
                    <property name="font">{Arial} 10 {}</property>
                    <property name="text_color">#565f7d</property>
                    <property name="justify">left</property>
                    <property name="anchor">w</property>
                    <layout>
                      <property name="row">1</property>
                      <property name="column">0</property>
                      <property name="sticky">ew</property>
                      <property name="padx">12</property>
                      <property name="pady">0 10</property>
                    </layout>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <!-- Карточка примера `metaclass_vars`. -->
              <object class="customtkinter.CTkFrame" id="card_metaclass_vars" name="card_metaclass_vars">
                <property name="fg_color">#171c29</property>
                <property name="border_color">#272f42</property>
                <property name="border_width">1</property>
                <property name="corner_radius">12</property>
                <layout>
                  <property name="row">3</property>
                  <property name="column">0</property>
                  <property name="sticky">ew</property>
                  <property name="pady">3</property>
                </layout>
                <child>
                  <object class="customtkinter.CTkLabel" id="card_title_metaclass_vars" name="card_title_metaclass_vars">
                    <property name="text">Metaclass: переменные внутри функций</property>
                    <property name="font">{Arial} 12 {bold}</property>
                    <property name="text_color">#d7defc</property>
                    <property name="anchor">w</property>
                    <layout>
                      <property name="row">0</property>
                      <property name="column">0</property>
                      <property name="sticky">ew</property>
                      <property name="padx">12</property>
                      <property name="pady">10 2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="customtkinter.CTkLabel" id="card_desc_metaclass_vars" name="card_desc_metaclass_vars">
                    <property name="text">Метакласс и область видимости</property>
                    <property name="font">{Arial} 10 {}</property>
                    <property name="text_color">#565f7d</property>
                    <property name="justify">left</property>
                    <property name="anchor">w</property>
                    <layout>
                      <property name="row">1</property>
                      <property name="column">0</property>
                      <property name="sticky">ew</property>
                      <property name="pady">0 10</property>
                    </layout>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <!-- Карточка примера `multiprocessing_demo`. -->
              <object class="customtkinter.CTkFrame" id="card_multiprocessing_demo" name="card_multiprocessing_demo">
                <property name="fg_color">#171c29</property>
                <property name="border_color">#272f42</property>
                <property name="border_width">1</property>
                <property name="corner_radius">12</property>
                <layout>
                  <property name="row">4</property>
                  <property name="column">0</property>
                  <property name="sticky">ew</property>
                  <property name="pady">3</property>
                </layout>
                <child>
                  <object class="customtkinter.CTkLabel" id="card_title_multiprocessing_demo" name="card_title_multiprocessing_demo">
                    <property name="text">Multiprocessing: Process / Pool / Executor</property>
                    <property name="font">{Arial} 12 {bold}</property>
                    <property name="text_color">#d7defc</property>
                    <property name="anchor">w</property>
                    <layout>
                      <property name="row">0</property>
                      <property name="column">0</property>
                      <property name="sticky">ew</property>
                      <property name="padx">12</property>
                      <property name="pady">10 2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="customtkinter.CTkLabel" id="card_desc_multiprocessing_demo" name="card_desc_multiprocessing_demo">
                    <property name="text">Process, Pool, Executor</property>
                    <property name="font">{Arial} 10 {}</property>
                    <property name="text_color">#565f7d</property>
                    <property name="justify">left</property>
                    <property name="anchor">w</property>
                    <layout>
                      <property name="row">1</property>
                      <property name="column">0</property>
                      <property name="sticky">ew</property>
                      <property name="padx">12</property>
                      <property name="pady">0 10</property>
                    </layout>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="customtkinter.CTkLabel" id="sidebar_footer" name="sidebar_footer">
            <property name="text">CustomTkinter 6.0.0 · pygubu 0.42</property>
            <property name="font">{Arial} 9 {}</property>
            <property name="text_color">#3f4763</property>
            <layout>
              <property name="row">4</property>
              <property name="column">0</property>
              <property name="sticky">w</property>
              <property name="padx">16</property>
              <property name="pady">8 12</property>
            </layout>
          </object>
        </child>
        <layout_manager>
          <property name="grid">y</property>
          <property name="row_weights">{0: 0, 1: 0, 2: 0, 3: 1, 4: 0}</property>
          <property name="column_weights">{0: 0}</property>
        </layout_manager>
      </object>
    </child>
    <child>
      <!--
          Контент: панель #11151f, радиус 16, растягивается по X/Y.
          Раскладка grid 1x9 (см. комментарий к main_frame).
      -->
      <object class="customtkinter.CTkFrame" id="content_frame" name="content_frame">
        <property name="fg_color">#11151f</property>
        <property name="corner_radius">16</property>
        <child>
          <!--
              Шапка: заголовок выбранного примера + описание.
              Тексты обновляются кодом при выборе карточки.
          -->
          <object class="customtkinter.CTkFrame" id="header_frame" name="header_frame">
            <property name="fg_color">transparent</property>
            <property name="corner_radius">0</property>
            <layout>
              <property name="row">0</property>
              <property name="column">0</property>
              <property name="sticky">ew</property>
              <property name="padx">18</property>
              <property name="pady">14 6</property>
            </layout>
            <child>
              <object class="customtkinter.CTkLabel" id="example_title" name="example_title">
                <property name="text">Выберите пример</property>
                <property name="font">{Arial} 21 {bold}</property>
                <property name="text_color">#ffffff</property>
                <layout>
                  <property name="row">0</property>
                  <property name="column">0</property>
                  <property name="sticky">w</property>
                  <property name="padx">0</property>
                  <property name="pady">0 2</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="customtkinter.CTkLabel" id="example_desc" name="example_desc">
                <property name="text">Кликните по карточке слева, чтобы выбрать пример</property>
                <property name="font">{Arial} 11 {}</property>
                <property name="text_color">#7d87a8</property>
                <layout>
                  <property name="row">1</property>
                  <property name="column">0</property>
                  <property name="sticky">w</property>
                  <property name="padx">0</property>
                  <property name="pady">0</property>
                </layout>
              </object>
            </child>
            <layout_manager>
              <property name="grid">y</property>
              <property name="row_weights">{0: 0, 1: 0}</property>
              <property name="column_weights">{0: 0}</property>
            </layout_manager>
          </object>
        </child>
        <child>
          <!--
              Панель оформления: переключатель темы + выбор акцентного цвета.
              Обработчики подключает код (theme_segmented / accent_menu).
          -->
          <object class="customtkinter.CTkFrame" id="topbar_frame" name="topbar_frame">
            <property name="fg_color">transparent</property>
            <property name="corner_radius">0</property>
            <layout>
              <property name="row">1</property>
              <property name="column">0</property>
              <property name="sticky">ew</property>
              <property name="padx">18</property>
              <property name="pady">0 8</property>
            </layout>
            <child>
              <object class="customtkinter.CTkLabel" id="theme_label" name="theme_label">
                <property name="text">Оформление</property>
                <property name="font">{Arial} 11 {}</property>
                <property name="text_color">#7d87a8</property>
                <layout>
                  <property name="row">0</property>
                  <property name="column">0</property>
                  <property name="sticky">w</property>
                  <property name="padx">0 8</property>
                  <property name="pady">0</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="customtkinter.CTkSegmentedButton" id="theme_segmented" name="theme_segmented">
                <property name="values">["Тёмная", "Светлая", "Система"]</property>
                <property name="font">{Arial} 11 {}</property>
                <property name="fg_color">#171c29</property>
                <property name="selected_color">#6d8dff</property>
                <property name="selected_hover_color">#8aa2ff</property>
                <property name="unselected_color">#1d2434</property>
                <property name="unselected_hover_color">#232c42</property>
                <property name="text_color">#d7defc</property>
                <property name="corner_radius">9</property>
                <property name="height">30</property>
                <layout>
                  <property name="row">0</property>
                  <property name="column">1</property>
                  <property name="sticky">w</property>
                  <property name="padx">0</property>
                  <property name="pady">0</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="customtkinter.CTkLabel" id="accent_label" name="accent_label">
                <property name="text">Акцент</property>
                <property name="font">{Arial} 11 {}</property>
                <property name="text_color">#7d87a8</property>
                <layout>
                  <property name="row">0</property>
                  <property name="column">2</property>
                  <property name="sticky">e</property>
                  <property name="padx">12 8</property>
                  <property name="pady">0</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="customtkinter.CTkOptionMenu" id="accent_menu" name="accent_menu">
                <property name="values">["Синий", "Циан", "Зелёный", "Розовый", "Янтарный"]</property>
                <property name="font">{Arial} 11 {}</property>
                <property name="fg_color">#171c29</property>
                <property name="button_color">#272f42</property>
                <property name="button_hover_color">#34405c</property>
