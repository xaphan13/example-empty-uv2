<?xml version="1.0" encoding="UTF-8"?>
<!--
    Pygubu-разметка главного окна ex_window_app_customtkinter (фаза 7: редизайн v2).

    Корневой объект — `customtkinter.CTkFrame` id `main_frame` на тёмном
    фоне `#1a1b26`. Окно `ctk.CTk()`, `ctk.set_appearance_mode("Dark")` и
    `ctk.set_default_color_theme("blue")` создаёт код в
    `application_window.py`; здесь корневой фрейм встраивается в окно
    через `Builder.get_object('main_frame', master=window)`.

    Раскладка — grid 2 столбца:
      - столбец 0: сайдбар (sidebar_frame) фиксированной ширины 280 px.
      - столбец 1: контент (content_frame) растягивается (weight=1).
    Grid-веса настраиваются кодом (фаза 7 v2); в .ui row/column_weights
    оставлены для pygubu-designer'а, но рантайм-веса принудительно
    пересчитываются в `application_window.py.__init__`.

    В сайдбаре сверху вниз: заголовок, поле поиска, счётчик
    «Найдено: N из 5», CTkScrollableFrame со списком карточек примеров
    (5 штук: async_context_var, valid_bracket, zip_operations,
    metaclass_vars, multiprocessing_demo).

    В контенте сверху вниз:
      - шапка (example_title крупным, example_desc);
      - панель опций (options_frame: clear_before_run_switch, autoscroll_switch);
      - ряд из трёх метрик (metrics_frame: metric_card_registry,
        metric_card_last_run, metric_card_status; в каждой label + value);
      - output_text (растягивается, основная площадь);
      - панель кнопок (buttons_frame: run_button, clear_button, copy_button);
      - progressbar;
      - status_label.

    Палитра — Tokyo Night (см. раздел «Цветовая палитра» в дизайн-спецификации
    REQUIREMENTS.md). Тексты — на русском.

    Формат составных отступов в `<property name="padx"/"pady">` — `a b`
    через пробел (tkinter не парсит `(a, b)`).
-->
<interface>
  <requires lib="customtkinter"/>
  <object class="customtkinter.CTkFrame" id="main_frame" name="main_frame">
    <property name="fg_color">#1a1b26</property>
    <property name="corner_radius">0</property>
    <property name="width">900</property>
    <property name="height">600</property>
    <child>
      <!--
          Сайдбар: фиксированная ширина 280 px, тёмный фон #16161e,
          скруглённые углы. Содержимое:
          row 0 — sidebar_title;
          row 1 — search_entry;
          row 2 — search_counter;
          row 3 — cards_scroll (растягивается).
      -->
      <object class="customtkinter.CTkFrame" id="sidebar_frame" name="sidebar_frame">
        <property name="fg_color">#16161e</property>
        <property name="corner_radius">12</property>
        <property name="width">280</property>
        <child>
          <object class="customtkinter.CTkLabel" id="sidebar_title" name="sidebar_title">
            <property name="text">Примеры</property>
            <property name="font">{Arial} 16 {bold}</property>
            <property name="text_color">#7aa2f7</property>
            <layout>
              <property name="row">0</property>
              <property name="column">0</property>
              <property name="sticky">w</property>
              <property name="padx">12</property>
              <property name="pady">12 8</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="customtkinter.CTkEntry" id="search_entry" name="search_entry">
            <property name="placeholder_text">Поиск примера...</property>
            <property name="placeholder_text_color">#565f89</property>
            <property name="fg_color">#292e42</property>
            <property name="border_color">#3b4261</property>
            <property name="text_color">#c0caf5</property>
            <property name="corner_radius">8</property>
            <layout>
              <property name="row">1</property>
              <property name="column">0</property>
              <property name="sticky">ew</property>
              <property name="padx">12</property>
              <property name="pady">0 8</property>
            </layout>
          </object>
        </child>
        <child>
          <!--
              Счётчик найденных карточек. Текст обновляется кодом
              (формат «Найдено: N из 5»).
          -->
          <object class="customtkinter.CTkLabel" id="search_counter" name="search_counter">
            <property name="text">Найдено: 5 из 5</property>
            <property name="font">{Arial} 10 {}</property>
            <property name="text_color">#565f89</property>
            <layout>
              <property name="row">2</property>
              <property name="column">0</property>
              <property name="sticky">w</property>
              <property name="padx">14</property>
              <property name="pady">0 6</property>
            </layout>
          </object>
        </child>
        <child>
          <!--
              CTkScrollableFrame: прозрачный фон, без скруглений,
              занимает всю оставшуюся высоту сайдбара. Карточки-примеры
              добавляются как row=0..4 внутри этого фрейма.
          -->
          <object class="customtkinter.CTkScrollableFrame" id="cards_scroll" name="cards_scroll">
            <property name="fg_color">transparent</property>
            <property name="corner_radius">0</property>
            <layout>
              <property name="row">3</property>
              <property name="column">0</property>
              <property name="sticky">nsew</property>
              <property name="padx">8</property>
              <property name="pady">4</property>
            </layout>
            <child>
              <!--
                  Карточка примера `async_context_var`.
                  Стили: corner_radius=10, фон #292e42, тонкая рамка #3b4261.
                  Заголовок и описание — CTkLabel с фиксированными шрифтами.
                  Текст заголовка/описания задаётся в .ui (соответствует
                  реестру в `example_runner.py`).
              -->
              <object class="customtkinter.CTkFrame" id="card_async_context_var" name="card_async_context_var">
                <property name="fg_color">#292e42</property>
                <property name="border_color">#3b4261</property>
                <property name="border_width">1</property>
                <property name="corner_radius">10</property>
                <layout>
                  <property name="row">0</property>
                  <property name="column">0</property>
                  <property name="sticky">ew</property>
                  <property name="pady">4</property>
                </layout>
                <child>
                  <object class="customtkinter.CTkLabel" id="card_title_async_context_var" name="card_title_async_context_var">
                    <property name="text">Async: ContextVar в задачах</property>
                    <property name="font">{Arial} 12 {bold}</property>
                    <property name="text_color">#c0caf5</property>
                    <layout>
                      <property name="row">0</property>
                      <property name="column">0</property>
                      <property name="sticky">w</property>
                      <property name="padx">12</property>
                      <property name="pady">10 2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="customtkinter.CTkLabel" id="card_desc_async_context_var" name="card_desc_async_context_var">
                    <property name="text">ContextVar и asyncio-задачи</property>
                    <property name="font">{Arial} 10 {}</property>
                    <property name="text_color">#565f89</property>
                    <property name="justify">left</property>
                    <layout>
                      <property name="row">1</property>
                      <property name="column">0</property>
                      <property name="sticky">w</property>
                      <property name="padx">12</property>
                      <property name="pady">0 10</property>
                    </layout>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <!-- Карточка примера `valid_bracket`. -->
              <object class="customtkinter.CTkFrame" id="card_valid_bracket" name="card_valid_bracket">
                <property name="fg_color">#292e42</property>
                <property name="border_color">#3b4261</property>
                <property name="border_width">1</property>
                <property name="corner_radius">10</property>
                <layout>
                  <property name="row">1</property>
                  <property name="column">0</property>
                  <property name="sticky">ew</property>
                  <property name="pady">4</property>
                </layout>
                <child>
                  <object class="customtkinter.CTkLabel" id="card_title_valid_bracket" name="card_title_valid_bracket">
                    <property name="text">Code War: проверка скобочных последовательностей</property>
                    <property name="font">{Arial} 12 {bold}</property>
                    <property name="text_color">#c0caf5</property>
                    <layout>
                      <property name="row">0</property>
                      <property name="column">0</property>
                      <property name="sticky">w</property>
                      <property name="padx">12</property>
                      <property name="pady">10 2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="customtkinter.CTkLabel" id="card_desc_valid_bracket" name="card_desc_valid_bracket">
                    <property name="text">Баланс скобок в строке</property>
                    <property name="font">{Arial} 10 {}</property>
                    <property name="text_color">#565f89</property>
                    <property name="justify">left</property>
                    <layout>
                      <property name="row">1</property>
                      <property name="column">0</property>
                      <property name="sticky">w</property>
                      <property name="padx">12</property>
                      <property name="pady">0 10</property>
                    </layout>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <!-- Карточка примера `zip_operations`. -->
              <object class="customtkinter.CTkFrame" id="card_zip_operations" name="card_zip_operations">
                <property name="fg_color">#292e42</property>
                <property name="border_color">#3b4261</property>
                <property name="border_width">1</property>
                <property name="corner_radius">10</property>
                <layout>
                  <property name="row">2</property>
                  <property name="column">0</property>
                  <property name="sticky">ew</property>
                  <property name="pady">4</property>
                </layout>
                <child>
                  <object class="customtkinter.CTkLabel" id="card_title_zip_operations" name="card_title_zip_operations">
                    <property name="text">ZIP: запись и чтение архивов</property>
                    <property name="font">{Arial} 12 {bold}</property>
                    <property name="text_color">#c0caf5</property>
                    <layout>
                      <property name="row">0</property>
                      <property name="column">0</property>
                      <property name="sticky">w</property>
                      <property name="padx">12</property>
                      <property name="pady">10 2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="customtkinter.CTkLabel" id="card_desc_zip_operations" name="card_desc_zip_operations">
                    <property name="text">zipfile: создание и чтение</property>
                    <property name="font">{Arial} 10 {}</property>
                    <property name="text_color">#565f89</property>
                    <property name="justify">left</property>
                    <layout>
                      <property name="row">1</property>
                      <property name="column">0</property>
                      <property name="sticky">w</property>
                      <property name="padx">12</property>
                      <property name="pady">0 10</property>
                    </layout>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <!-- Карточка примера `metaclass_vars`. -->
              <object class="customtkinter.CTkFrame" id="card_metaclass_vars" name="card_metaclass_vars">
                <property name="fg_color">#292e42</property>
                <property name="border_color">#3b4261</property>
                <property name="border_width">1</property>
                <property name="corner_radius">10</property>
                <layout>
                  <property name="row">3</property>
                  <property name="column">0</property>
                  <property name="sticky">ew</property>
                  <property name="pady">4</property>
                </layout>
                <child>
                  <object class="customtkinter.CTkLabel" id="card_title_metaclass_vars" name="card_title_metaclass_vars">
                    <property name="text">Metaclass: переменные внутри функций</property>
                    <property name="font">{Arial} 12 {bold}</property>
                    <property name="text_color">#c0caf5</property>
                    <layout>
                      <property name="row">0</property>
                      <property name="column">0</property>
                      <property name="sticky">w</property>
                      <property name="padx">12</property>
                      <property name="pady">10 2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="customtkinter.CTkLabel" id="card_desc_metaclass_vars" name="card_desc_metaclass_vars">
                    <property name="text">Метакласс и область видимости</property>
                    <property name="font">{Arial} 10 {}</property>
                    <property name="text_color">#565f89</property>
                    <property name="justify">left</property>
                    <layout>
                      <property name="row">1</property>
                      <property name="column">0</property>
                      <property name="sticky">w</property>
                      <property name="padx">12</property>
                      <property name="pady">0 10</property>
                    </layout>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <!-- Карточка примера `multiprocessing_demo`. -->
              <object class="customtkinter.CTkFrame" id="card_multiprocessing_demo" name="card_multiprocessing_demo">
                <property name="fg_color">#292e42</property>
                <property name="border_color">#3b4261</property>
                <property name="border_width">1</property>
                <property name="corner_radius">10</property>
                <layout>
                  <property name="row">4</property>
                  <property name="column">0</property>
                  <property name="sticky">ew</property>
                  <property name="pady">4</property>
                </layout>
                <child>
                  <object class="customtkinter.CTkLabel" id="card_title_multiprocessing_demo" name="card_title_multiprocessing_demo">
                    <property name="text">Multiprocessing: Process / Pool / Executor</property>
                    <property name="font">{Arial} 12 {bold}</property>
                    <property name="text_color">#c0caf5</property>
                    <layout>
                      <property name="row">0</property>
                      <property name="column">0</property>
                      <property name="sticky">w</property>
                      <property name="padx">12</property>
                      <property name="pady">10 2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="customtkinter.CTkLabel" id="card_desc_multiprocessing_demo" name="card_desc_multiprocessing_demo">
                    <property name="text">Process, Pool, Executor</property>
                    <property name="font">{Arial} 10 {}</property>
                    <property name="text_color">#565f89</property>
                    <property name="justify">left</property>
                    <layout>
                      <property name="row">1</property>
                      <property name="column">0</property>
                      <property name="sticky">w</property>
                      <property name="padx">12</property>
                      <property name="pady">0 10</property>
                    </layout>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <layout_manager>
          <property name="grid">y</property>
          <property name="row_weights">{0: 0, 1: 0, 2: 0, 3: 1}</property>
          <property name="column_weights">{0: 0}</property>
        </layout_manager>
      </object>
    </child>
    <child>
      <!--
          Контент: растягивается по горизонтали, занимает правую часть окна.
          Раскладка grid 1×7:
            row 0 — example_title + example_desc (шапка);
            row 1 — options_frame (свитчи);
            row 2 — metrics_frame (три мини-карточки);
            row 3 — output_text (растягивается, weight=1);
            row 4 — buttons_frame (run/clear/copy);
            row 5 — progressbar;
            row 6 — status_label.
      -->
      <object class="customtkinter.CTkFrame" id="content_frame" name="content_frame">
        <property name="fg_color">#1f2335</property>
        <property name="corner_radius">12</property>
        <child>
          <!--
              Шапка: CTkFrame с двумя label'ами (title крупным + desc).
              Тексты обновляются кодом при выборе карточки.
          -->
          <object class="customtkinter.CTkFrame" id="header_frame" name="header_frame">
            <property name="fg_color">transparent</property>
            <property name="corner_radius">0</property>
            <layout>
              <property name="row">0</property>
              <property name="column">0</property>
              <property name="sticky">ew</property>
              <property name="padx">12</property>
              <property name="pady">8 4</property>
            </layout>
            <child>
              <object class="customtkinter.CTkLabel" id="example_title" name="example_title">
                <property name="text">Выберите пример</property>
                <property name="font">{Arial} 20 {bold}</property>
                <property name="text_color">#e8ecfd</property>
                <layout>
                  <property name="row">0</property>
                  <property name="column">0</property>
                  <property name="sticky">w</property>
                  <property name="padx">4</property>
                  <property name="pady">0 2</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="customtkinter.CTkLabel" id="example_desc" name="example_desc">
                <property name="text">Кликните по карточке слева, чтобы выбрать пример</property>
                <property name="font">{Arial} 11 {}</property>
                <property name="text_color">#565f89</property>
                <layout>
                  <property name="row">1</property>
                  <property name="column">0</property>
                  <property name="sticky">w</property>
                  <property name="padx">4</property>
                  <property name="pady">0</property>
                </layout>
              </object>
            </child>
            <layout_manager>
              <property name="grid">y</property>
              <property name="row_weights">{0: 0, 1: 0}</property>
              <property name="column_weights">{0: 0}</property>
            </layout_manager>
          </object>
        </child>
        <child>
          <!--
              Панель опций: два CTkSwitch на одной строке.
              CTkSwitch в плагине pygubu зарегистрирован (class CTkSwitchBO
              в widgets.py, требует `lib="customtkinter"`). Состояние on/off
              задаётся кодом через `switch.select()` / `switch.deselect()`.
          -->
          <object class="customtkinter.CTkFrame" id="options_frame" name="options_frame">
            <property name="fg_color">transparent</property>
            <property name="corner_radius">0</property>
            <layout>
              <property name="row">1</property>
              <property name="column">0</property>
              <property name="sticky">ew</property>
              <property name="padx">12</property>
              <property name="pady">0 8</property>
            </layout>
            <child>
              <object class="customtkinter.CTkSwitch" id="clear_before_run_switch" name="clear_before_run_switch">
                <property name="text">Очистка перед запуском</property>
                <property name="text_color">#c0caf5</property>
                <property name="progress_color">#7aa2f7</property>
                <property name="fg_color">#3b4261</property>
                <property name="button_color">#7aa2f7</property>
                <property name="button_hover_color">#89b4fa</property>
                <property name="font">{Arial} 11 {}</property>
                <layout>
                  <property name="row">0</property>
                  <property name="column">0</property>
                  <property name="sticky">w</property>
                  <property name="padx">8</property>
                  <property name="pady">0</property>
                </layout>
              </object>
            </child>
            <child>
              <object class="customtkinter.CTkSwitch" id="autoscroll_switch" name="autoscroll_switch">
                <property name="text">Автопрокрутка вывода</property>
                <property name="text_color">#c0caf5</property>
                <property name="progress_color">#7aa2f7</property>
                <property name="fg_color">#3b4261</property>
                <property name="button_color">#7aa2f7</property>
                <property name="button_hover_color">#89b4fa</property>
                <property name="font">{Arial} 11 {}</property>
                <layout>
                  <property name="row">0</property>
                  <property name="column">1</property>
                  <property name="sticky">w</property>
                  <property name="padx">16</property>
                  <property name="pady">0</property>
                </layout>
              </object>
            </child>
            <layout_manager>
              <property name="grid">x</property>
              <property name="row_weights">{0: 0}</property>
              <property name="column_weights">{0: 0, 1: 0}</property>
            </layout_manager>
          </object>
        </child>
        <child>
          <!--
              Ряд из трёх мини-карточек-метрик. Сетка 1×3, занимает всю ширину.
              Цвета — палитра Tokyo Night (см. спеке).
          -->
          <object class="customtkinter.CTkFrame" id="metrics_frame" name="metrics_frame">
            <property name="fg_color">transparent</property>
            <property name="corner_radius">0</property>
            <layout>
              <property name="row">2</property>
              <property name="column">0</property>
              <property name="sticky">ew</property>
              <property name="padx">12</property>
              <property name="pady">0 8</property>
            </layout>
            <child>
              <!-- Мини-карточка «Примеров в реестре». -->
              <object class="customtkinter.CTkFrame" id="metric_card_registry" name="metric_card_registry">
                <property name="fg_color">#292e42</property>
                <property name="border_color">#3b4261</property>
                <property name="border_width">1</property>
                <property name="corner_radius">10</property>
                <layout>
                  <property name="row">0</property>
                  <property name="column">0</property>
                  <property name="sticky">ew</property>
                  <property name="padx">0 6</property>
                  <property name="pady">0</property>
                </layout>
                <child>
                  <object class="customtkinter.CTkLabel" id="metric_registry_label" name="metric_registry_label">
                    <property name="text">Примеров в реестре</property>
                    <property name="font">{Arial} 10 {}</property>
                    <property name="text_color">#565f89</property>
                    <layout>
                      <property name="row">0</property>
                      <property name="column">0</property>
                      <property name="sticky">w</property>
                      <property name="padx">12</property>
                      <property name="pady">8 2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="customtkinter.CTkLabel" id="metric_registry_value" name="metric_registry_value">
                    <property name="text">5</property>
                    <property name="font">{Arial} 16 {bold}</property>
                    <property name="text_color">#7dcfff</property>
                    <layout>
                      <property name="row">1</property>
                      <property name="column">0</property>
                      <property name="sticky">w</property>
                      <property name="padx">12</property>
                      <property name="pady">0 8</property>
                    </layout>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <!-- Мини-карточка «Последний запуск». -->
              <object class="customtkinter.CTkFrame" id="metric_card_last_run" name="metric_card_last_run">
                <property name="fg_color">#292e42</property>
                <property name="border_color">#3b4261</property>
                <property name="border_width">1</property>
                <property name="corner_radius">10</property>
                <layout>
                  <property name="row">0</property>
                  <property name="column">1</property>
                  <property name="sticky">ew</property>
                  <property name="padx">3 3</property>
                  <property name="pady">0</property>
                </layout>
                <child>
                  <object class="customtkinter.CTkLabel" id="metric_last_run_label" name="metric_last_run_label">
                    <property name="text">Последний запуск</property>
                    <property name="font">{Arial} 10 {}</property>
                    <property name="text_color">#565f89</property>
                    <layout>
                      <property name="row">0</property>
                      <property name="column">0</property>
                      <property name="sticky">w</property>
                      <property name="padx">12</property>
                      <property name="pady">8 2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="customtkinter.CTkLabel" id="metric_last_run_value" name="metric_last_run_value">
                    <property name="text">—</property>
                    <property name="font">{Arial} 13 {bold}</property>
                    <property name="text_color">#9ece6a</property>
                    <layout>
                      <property name="row">1</property>
                      <property name="column">0</property>
                      <property name="sticky">w</property>
                      <property name="padx">12</property>
                      <property name="pady">0 8</property>
                    </layout>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <!-- Мини-карточка «Статус». -->
              <object class="customtkinter.CTkFrame" id="metric_card_status" name="metric_card_status">
                <property name="fg_color">#292e42</property>
                <property name="border_color">#3b4261</property>
                <property name="border_width">1</property>
                <property name="corner_radius">10</property>
                <layout>
                  <property name="row">0</property>
                  <property name="column">2</property>
                  <property name="sticky">ew</property>
                  <property name="padx">6 0</property>
                  <property name="pady">0</property>
                </layout>
                <child>
                  <object class="customtkinter.CTkLabel" id="metric_status_label" name="metric_status_label">
                    <property name="text">Статус</property>
                    <property name="font">{Arial} 10 {}</property>
                    <property name="text_color">#565f89</property>
                    <layout>
                      <property name="row">0</property>
                      <property name="column">0</property>
                      <property name="sticky">w</property>
                      <property name="padx">12</property>
                      <property name="pady">8 2</property>
                    </layout>
                  </object>
                </child>
                <child>
                  <object class="customtkinter.CTkLabel" id="metric_status_value" name="metric_status_value">
                    <property name="text">Готово</property>
                    <property name="font">{Arial} 13 {bold}</property>
                    <property name="text_color">#c0caf5</property>
                    <layout>
                      <property name="row">1</property>
                      <property name="column">0</property>
                      <property name="sticky">w</property>
                      <property name="padx">12</property>
                      <property name="pady">0 8</property>
                    </layout>
                  </object>
                </child>
              </object>
            </child>
            <layout_manager>
              <property name="grid">x</property>
              <property name="row_weights">{0: 0}</property>
              <property name="column_weights">{0: 1, 1: 1, 2: 1}</property>
            </layout_manager>
          </object>
        </child>
        <child>
          <!--
              Панель вывода («терминал»): тёмный фон #101017, моноширинный
              шрифт, перенос по словам. Растягивается на всю оставшуюся
              высоту контента (row 3, weight=1).
          -->
          <object class="customtkinter.CTkTextbox" id="output_text" name="output_text">
            <property name="fg_color">#101017</property>
            <property name="text_color">#c0caf5</property>
            <property name="border_color">#3b4261</property>
            <property name="border_width">1</property>
            <property name="corner_radius">8</property>
            <property name="font">{JetBrains Mono} 10 {}</property>
            <property name="wrap">word</property>
            <property name="state">normal</property>
            <layout>
              <property name="row">3</property>
              <property name="column">0</property>
              <property name="sticky">nsew</property>
              <property name="padx">12</property>
              <property name="pady">0 8</property>
            </layout>
          </object>
        </child>
        <child>
          <!--
              Панель кнопок: три CTkButton на одной строке.
              Сетка 1×3, weight=0 (фиксированные ширины).
          -->
          <object class="customtkinter.CTkFrame" id="buttons_frame" name="buttons_frame">
            <property name="fg_color">transparent</property>
            <property name="corner_radius">0</property>
            <layout>
              <property name="row">4</property>
              <property name="column">0</property>
              <property name="sticky">ew</property>
              <property name="padx">12</property>
              <property name="pady">0 8</property>
            </layout>
            <child>
              <!--
                  Кнопка «Запустить»: акцентный синий #7aa2f7, hover #89b4fa,
                  фиксированный размер 140×36, шрифт Arial 12 bold.
              -->
              <object class="customtkinter.CTkButton" id="run_button" name="run_button">
                <property name="text">Запустить</property>
                <property name="fg_color">#7aa2f7</property>
                <property name="hover_color">#89b4fa</property>
                <property name="text_color">#1a1b26</property>
                <property name="corner_radius">10</property>
                <property name="font">{Arial} 12 {bold}</property>
                <property name="width">140</property>
                <property name="height">36</property>
                <layout>
                  <property name="row">0</property>
                  <property name="column">0</property>
                  <property name="sticky">w</property>
                  <property name="padx">4</property>
                  <property name="pady">0</property>
                </layout>
              </object>
            </child>
            <child>
              <!--
                  Кнопка «Очистить»: нейтральный серый #292e42, hover #363e59,
                  фиксированный размер 100×32.
              -->
              <object class="customtkinter.CTkButton" id="clear_button" name="clear_button">
                <property name="text">Очистить</property>
                <property name="fg_color">#292e42</property>
                <property name="hover_color">#363e59</property>
                <property name="text_color">#c0caf5</property>
                <property name="corner_radius">10</property>
                <property name="font">{Arial} 12 {}</property>
                <property name="width">100</property>
                <property name="height">32</property>
                <layout>
                  <property name="row">0</property>
                  <property name="column">1</property>
                  <property name="sticky">w</property>
                  <property name="padx">8</property>
                  <property name="pady">0</property>
                </layout>
              </object>
            </child>
            <child>
              <!--
                  Кнопка «Копировать»: тот же нейтральный стиль, 120×32.
                  Копирует содержимое output_text в буфер обмена.
              -->
              <object class="customtkinter.CTkButton" id="copy_button" name="copy_button">
                <property name="text">Копировать</property>
                <property name="fg_color">#292e42</property>
                <property name="hover_color">#363e59</property>
                <property name="text_color">#c0caf5</property>
                <property name="corner_radius">10</property>
                <property name="font">{Arial} 12 {}</property>
                <property name="width">120</property>
                <property name="height">32</property>
                <layout>
                  <property name="row">0</property>
                  <property name="column">2</property>
                  <property name="sticky">w</property>
                  <property name="padx">8</property>
                  <property name="pady">0</property>
                </layout>
              </object>
            </child>
            <layout_manager>
              <property name="grid">x</property>
              <property name="row_weights">{0: 0}</property>
              <property name="column_weights">{0: 0, 1: 0, 2: 0}</property>
            </layout_manager>
          </object>
        </child>
        <child>
          <!--
              Прогрессбар. fg_color — бордюр/фон дорожки, progress_color —
              акцент. Анимация «выполняется» через .start() / .stop() в коде.
          -->
          <object class="customtkinter.CTkProgressBar" id="progressbar" name="progressbar">
            <property name="fg_color">#292e42</property>
            <property name="progress_color">#7aa2f7</property>
            <property name="corner_radius">6</property>
            <property name="height">8</property>
            <layout>
              <property name="row">5</property>
              <property name="column">0</property>
              <property name="sticky">ew</property>
              <property name="padx">12</property>
              <property name="pady">0 4</property>
            </layout>
          </object>
        </child>
        <child>
          <!-- Статусная строка: вторичный цвет #565f89, мелкий шрифт. -->
          <object class="customtkinter.CTkLabel" id="status_label" name="status_label">
            <property name="text">Готово</property>
            <property name="text_color">#565f89</property>
            <property name="font">{Arial} 10 {}</property>
            <layout>
              <property name="row">6</property>
              <property name="column">0</property>
              <property name="sticky">w</property>
              <property name="padx">16</property>
              <property name="pady">0 8</property>
            </layout>
          </object>
        </child>
        <layout_manager>
          <property name="grid">y</property>
          <property name="row_weights">{0: 0, 1: 0, 2: 0, 3: 1, 4: 0, 5: 0, 6: 0}</property>
          <property name="column_weights">{0: 0}</property>
        </layout_manager>
      </object>
    </child>
    <layout_manager>
      <property name="grid">x</property>
      <property name="geometry">900x600</property>
      <property name="row_weights">{0: 1}</property>
      <property name="column_weights">{0: 0, 1: 1}</property>
    </layout_manager>
  </object>
</interface>
